e-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n</style>\n\n<!-- Open Graph / SEO orgânico -->\n\n<meta property=\"og:site_name\" content=\"ABREV\">\n<meta property=\"og:locale\" content=\"pt_BR\">\n\n\n\n<meta property=\"og:image\" content=\"https://abrev.org/blog/assets/abrev-logo.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n\n\n<!-- Schema.org: melhora indexação orgânica -->\n\n\n<style>\n:root{--navy:#153244;--navy2:#091d29;--green:#a4c63d;--teal:#0ca2a6;--yellow:#f7c842;--cream:#fbf8f0;--white:#fff;--ink:#183545;--muted:#607581;--line:rgba(21,50,68,.12);--d:'Montserrat',sans-serif;--b:'Inter',sans-serif;--shadow:0 24px 70px rgba(7,26,37,.16)}\n*{box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--cream);color:var(--ink);font-family:var(--b);line-height:1.7;overflow-x:hidden}\nimg{display:block;max-width:100%}\na{color:inherit}\n.wrap{width:min(1200px,calc(100% - 40px));margin:auto}\n.skip{position:absolute;left:-999px}\n.skip:focus{left:16px;top:16px;z-index:9999;background:#fff;padding:10px 14px;border-radius:8px}\n:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}\n\n/* ---- Header (idêntico ao site) ---- */\n.nav{position:sticky;top:0;z-index:100;background:rgba(251,248,240,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}\n.navin{display:flex;align-items:center;justify-content:space-between;padding:14px 0}\n.brand img{width:180px}\n.links{display:flex;gap:30px;align-items:center}\n.links a{font:600 .92rem var(--b);text-decoration:none;color:var(--ink);opacity:.82;transition:.2s}\n.links a:hover,.links a[aria-current]{opacity:1;color:var(--teal)}\n.navcta{background:var(--navy);color:#fff!important;padding:11px 20px;border-radius:999px;opacity:1!important}\n.navcta:hover{background:var(--teal)}\n.menu{display:none;border:0;background:none;padding:10px;cursor:pointer}\n.menu span{display:block;width:24px;height:2px;background:var(--navy);margin:5px 0}\n\n/* ---- Article ---- */\n.arthero{background:linear-gradient(160deg,var(--navy) 0%,var(--navy2) 100%);color:#fff;padding:66px 0 88px;position:relative;overflow:hidden}\n.arthero:after{content:\"\";position:absolute;right:-140px;top:-140px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(12,162,166,.35),transparent 60%)}\n.crumbs{font:600 .78rem var(--b);letter-spacing:.02em;color:rgba(255,255,255,.78);margin-bottom:22px}\n.crumbs a{color:rgba(255,255,255,.8);text-decoration:none}\n.crumbs a:hover{color:var(--green)}\n.pill{display:inline-block;background:var(--green);color:var(--navy2);font:800 .7rem var(--d);letter-spacing:.08em;text-transform:uppercase;padding:7px 14px;border-radius:999px}\n.arthero h1{font:900 clamp(2.1rem,5vw,3.6rem)/1.05 var(--d);margin:20px 0 16px;max-width:20ch;position:relative;z-index:1}\n.arthero .lede{font-size:clamp(1.05rem,2vw,1.32rem);color:rgba(255,255,255,.82);max-width:60ch;margin:0}\n.artmeta{display:flex;flex-wrap:wrap;gap:26px;margin-top:34px;font:600 .84rem var(--b);color:rgba(255,255,255,.72)}\n.artmeta b{color:#fff;font-weight:700}\n\n.article{max-width:760px;margin:0 auto;padding:56px 0 20px}\n.article p{font-size:1.09rem;margin:0 0 24px}\n.article h2{font:800 clamp(1.5rem,3vw,2.05rem)/1.15 var(--d);color:var(--navy);margin:52px 0 18px;letter-spacing:-.01em}\n.article h3{font:800 1.18rem var(--d);color:var(--navy);margin:34px 0 12px}\n.article strong{color:var(--navy)}\n.lead{font-size:1.24rem!important;color:var(--navy);font-weight:500}\n.dropcap::first-letter{font:900 4.2rem/.8 var(--d);float:left;color:var(--teal);margin:6px 12px 0 0}\n\n/* Big stat callouts */\n.statrow{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:38px 0}\n.stat{background:var(--white);border:1px solid var(--line);border-radius:20px;padding:26px 22px;box-shadow:0 12px 34px rgba(21,50,68,.06)}\n.stat .num{font:900 2.7rem/1 var(--d);color:#0a7d80}\n.stat .num.g{color:#587d0e}\n.stat .num.y{color:#9a6f00}\n.stat .lab{color:var(--muted);font-size:.92rem;margin-top:10px}\n\n/* Figure / charts */\n.fig{background:var(--white);border:1px solid var(--line);border-radius:24px;padding:30px 30px 24px;margin:34px 0;box-shadow:0 16px 44px rgba(21,50,68,.07)}\n.fig .cap{font:800 1.05rem var(--d);color:var(--navy);margin:0 0 4px}\n.fig .sub{color:var(--muted);font-size:.9rem;margin:0 0 20px}\n.fig .src{color:var(--muted);font-size:.78rem;margin:16px 0 0;padding-top:14px;border-top:1px solid var(--line)}\n.bar-label{font:700 .82rem var(--b);fill:var(--ink)}\n.bar-val{font:800 .9rem var(--d);fill:var(--navy)}\n.axis{font:600 .74rem var(--b);fill:var(--muted)}\n\n/* MUP framework */\n.mup{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:30px 0}\n.mup .c{border-radius:20px;padding:26px;color:#fff}\n.mup .c:nth-child(1){background:var(--teal)}\n.mup .c:nth-child(2){background:var(--navy)}\n.mup .c:nth-child(3){background:var(--green);color:var(--navy2)}\n.mup .c b{font:900 2.4rem var(--d);display:block;line-height:1}\n.mup .c h3{color:inherit;margin:12px 0 8px;font-size:1.08rem}\n.mup .c p{font-size:.92rem;margin:0;opacity:.92}\n\n/* Refund scale */\n.scale{display:flex;border-radius:14px;overflow:hidden;margin:22px 0 8px;box-shadow:0 10px 28px rgba(21,50,68,.08)}\n.scale div{flex:1;padding:16px 10px;text-align:center;color:#fff;font:700 .78rem var(--b)}\n.scale div b{display:block;font:800 .96rem var(--d);margin-bottom:3px}\n.scaleleg{color:var(--muted);font-size:.82rem;text-align:center}\n\n/* Quote */\n.pull{border-left:4px solid var(--green);background:rgba(164,198,61,.09);padding:24px 28px;border-radius:0 16px 16px 0;margin:34px 0;font:600 1.22rem/1.5 var(--d);color:var(--navy)}\n.pull cite{display:block;font:600 .82rem var(--b);color:var(--muted);margin-top:12px;font-style:normal}\n\n/* Takeaways */\n.take{background:var(--navy);color:#fff;border-radius:24px;padding:38px 34px;margin:44px 0}\n.take h3{color:#fff;font:800 1.4rem var(--d);margin:0 0 20px}\n.take ol{margin:0;padding:0;list-style:none;counter-reset:t}\n.take li{counter-increment:t;padding:14px 0 14px 52px;position:relative;border-top:1px solid rgba(255,255,255,.12)}\n.take li:first-child{border-top:0}\n.take li:before{content:counter(t);position:absolute;left:0;top:12px;width:34px;height:34px;border-radius:50%;background:var(--green);color:var(--navy2);font:900 1rem var(--d);display:flex;align-items:center;justify-content:center}\n.take li b{color:var(--yellow)}\n\n/* CTA */\n.cta{background:var(--yellow);border-radius:28px;padding:44px;margin:48px 0 10px;display:grid;grid-template-columns:1.2fr .8fr;gap:24px;align-items:center}\n.cta h3{font:900 clamp(1.6rem,3vw,2.3rem)/1.05 var(--d);color:var(--navy2);margin:0}\n.cta p{margin:10px 0 0;color:var(--navy);max-width:44ch}\n.cta .btn{justify-self:end;background:var(--navy);color:#fff;text-decoration:none;padding:16px 30px;border-radius:999px;font:800 .96rem var(--d);white-space:nowrap;transition:.2s}\n.cta .btn:hover{background:var(--navy2);transform:translateY(-2px)}\n\n\n/* Footer */\n.footer{background:#061720;color:#fff;padding:66px 0 26px;margin-top:40px}\n.foot{display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:36px}\n.footer img{width:210px}\n.footer h4{font:800 .72rem var(--d);text-transform:uppercase;letter-spacing:.12em;color:var(--green);margin:0 0 13px}\n.footer p,.footer a{color:rgba(255,255,255,.62);text-decoration:none}\n.footer a:hover{color:#fff}\n.fine{margin-top:40px;padding-top:22px;border-top:1px solid rgba(255,255,255,.1);font-size:.78rem;color:rgba(255,255,255,.38)}\n\n.reveal{opacity:0;transform:translateY(24px);transition:.7s ease}\n.reveal.in{opacity:1;transform:none}\n\n@media(max-width:820px){\n  .links{display:none}\n  .links.open{display:flex;flex-direction:column;align-items:flex-start;gap:16px;position:absolute;top:64px;right:20px;left:20px;background:var(--cream);border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:var(--shadow)}\n  .menu{display:block}\n  .statrow,.mup,.foot{grid-template-columns:1fr}\n  .cta{grid-template-columns:1fr}\n  .cta .btn{justify-self:start}\n  .scale{flex-direction:column}\n}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}}\n\n/* Pop-up: Faça parte da comunidade */\n.modal{position:fixed;inset:0;z-index:500;background:rgba(4,17,24,.72);backdrop-filter:blur(8px);display:grid;place-items:center;padding:20px;opacity:0;pointer-events:none;transition:.25s}\n.modal.show{opacity:1;pointer-events:auto}\n.modalCard{position:relative;width:min(880px,100%);display:grid;grid-template-columns:.85fr 1.15fr;background:#fff;border-radius:26px;overflow:hidden;box-shadow:0 35px 100px rgba(0,0,0,.35);transform:translateY(18px);transition:.3s}\n.modal.show .modalCard{transform:none}\n.modalVis{position:relative;background:linear-gradient(150deg,var(--teal),var(--navy));color:#fff;padding:40px 34px;display:flex;flex-direction:column;justify-content:space-between;gap:24px;overflow:hidden}\n.modalVis:after{content:\"\";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;background:rgba(247,200,66,.18)}\n.modalVis .mpill{position:relative;z-index:1;align-self:flex-start;background:var(--green);color:var(--navy2);font:800 .68rem var(--d);letter-spacing:.08em;text-transform:uppercase;padding:6px 12px;border-radius:999px}\n.modalVis strong{position:relative;z-index:1;font:900 1.9rem/1.05 var(--d);max-width:14ch}\n.modalBody{padding:44px 40px;position:relative}\n.modalBody .mkicker{font:800 .69rem var(--d);letter-spacing:.15em;text-transform:uppercase;color:var(--teal);margin:0 0 8px}\n.modalBody h3{font:900 1.9rem/1.05 var(--d);color:var(--navy);margin:0 0 12px}\n.modalBody>p{color:var(--muted);margin:0;font-size:1rem}\n.mform{display:grid;gap:10px;margin-top:22px}\n.mform input{height:50px;border:1px solid var(--line);border-radius:8px;padding:0 14px;font:500 .9rem var(--b)}\n.mform button{height:50px;border:0;border-radius:8px;background:var(--green);color:var(--navy2);font:800 .85rem var(--d);cursor:pointer;transition:.2s}\n.mform button:hover{background:var(--teal);color:#fff}\n.mform button:disabled{opacity:.6;cursor:default}\n.mnote{font-size:.73rem;color:var(--muted);margin-top:12px}\n.mnote a{color:var(--teal);font-weight:700}\n.mclose{position:absolute;right:16px;top:16px;z-index:3;width:38px;height:38px;border-radius:50%;border:0;background:rgba(255,255,255,.92);font-size:1.3rem;line-height:1;cursor:pointer}\n@media(max-width:640px){.modalCard{grid-template-columns:1fr}.modalVis{min-height:140px}.modalBody{padding:34px 24px}.modalBody h3{font-size:1.6rem}}\n\n/* Opt-in: receber por e-mail */\n.emailcta{text-align:center;border:1px solid var(--line);border-radius:24px;padding:40px 34px;margin:44px 0;background:linear-gradient(180deg,#fff,rgba(164,198,61,.10));box-shadow:0 16px 44px rgba(21,50,68,.08)}\n.emailcta-ico{font-size:2rem;line-height:1;margin-bottom:10px}\n.emailcta h3{font:800 clamp(1.3rem,2.6vw,1.75rem)/1.15 var(--d);color:var(--navy);margin:0 0 10px}\n.emailcta p{color:var(--muted);max-width:52ch;margin:0 auto 22px;font-size:1.02rem}\n.emailcta-btn{display:inline-block;background:var(--navy);color:#fff;border:0;cursor:pointer;padding:15px 30px;border-radius:999px;font:800 .95rem var(--d);transition:.2s}\n.emailcta-btn:hover{background:var(--teal);transform:translateY(-2px)}\n.estudoForm{max-width:460px;margin:0 auto;display:flex;flex-direction:column;gap:12px;text-align:left}\n.estudoForm input[type=text],.estudoForm input[type=email]{padding:13px 16px;border:1px solid var(--line);border-radius:12px;font:inherit;background:#fff}\n.estudoForm .optin{display:flex;gap:10px;align-items:flex-start;font-size:.88rem;color:var(--muted);line-height:1.45;cursor:pointer}\n.estudoForm .optin input{margin-top:3px;flex-shrink:0}\n.estudoForm .consent{font-size:.78rem;color:var(--muted);text-align:center;margin:4px 0 0}\n.estudoForm button{margin-top:2px}\n</style>\n\n<meta name=\"description\" content=\"Visibilidade, triagem e decisões de destino no pós-venda da Black Friday.\">\n<link rel=\"canonical\" href=\"https://abrev.org/blog/black-friday-e-a-onda-de-devolucoes.html\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:title\" content=\"Black Friday e a onda de devoluções\">\n<meta property=\"og:description\" content=\"Visibilidade, triagem e decisões de destino no pós-venda da Black Friday.\">\n<meta property=\"og:url\" content=\"https://abrev.org/blog/black-friday-e-a-onda-de-devolucoes.html\">\n\n<style>.guide-toc{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px;margin:0 0 36px}.guide-toc h2{margin:0 0 14px;font-size:1.2rem}.guide-toc a,.article a{color:#076f73;text-underline-offset:3px}.guide-toc ol{margin:0;padding-left:22px}.guide-toc li{margin:8px 0}.article h2{scroll-margin-top:110px}.table-scroll{overflow-x:auto;margin:28px 0}.guide-table{border-collapse:collapse;width:100%;font-size:.94rem}.guide-table caption{text-align:left;font-weight:700;margin-bottom:12px}.guide-table th,.guide-table td{border:1px solid #cad5d9;padding:14px;text-align:left;vertical-align:top}.guide-table th{background:#153244;color:white}.guide-table tr:nth-child(even){background:white}.article li{margin-bottom:12px}.guide-note{border-left:4px solid var(--green);padding:18px 22px;background:#fff;border-radius:0 14px 14px 0}</style>\n<script src=\"/assets/analytics.js?v=20261104-2\" defer></script>\n<style>img{height:auto}footer a{display:inline-block;min-height:24px}</style>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Black Friday e a onda de devoluções\", \"description\": \"Visibilidade, triagem e decisões de destino no pós-venda da Black Friday.\", \"datePublished\": \"2026-11-27T07:00:00-03:00\", \"author\": {\"@type\": \"Organization\", \"name\": \"ABREV\"}, \"publisher\": {\"@type\": \"Organization\", \"name\": \"ABREV\"}, \"inLanguage\": \"pt-BR\", \"mainEntityOfPage\": \"https://abrev.org/blog/black-friday-e-a-onda-de-devolucoes.html\"}</script>\n</head><body>\n<a class=\"skip\" href=\"#conteudo\">Pular para o conteúdo</a>\n\n<!-- HEADER -->\n<header class=\"nav\">\n  <div class=\"wrap navin\">\n    <a class=\"brand\" href=\"/\"><img src=\"/assets/images/abrev-logo-420.webp\" alt=\"ABREV — Associação Brasileira de Reversa do Varejo\" width=\"1142\" height=\"240\" decoding=\"async\" srcset=\"/assets/images/abrev-logo-210.webp 210w, /assets/images/abrev-logo-420.webp 420w, /assets/images/abrev-logo-630.webp 630w\" sizes=\"210px\"></a>\n    <button class=\"menu\" aria-label=\"Abrir menu\" aria-expanded=\"false\" onclick=\"var l=document.querySelector('.links'),o=l.classList.toggle('open');this.setAttribute('aria-expanded',o);this.setAttribute('aria-label',o?'Fechar menu':'Abrir menu')\"><span></span><span></span><span></span></button>\n    <nav class=\"links\" aria-label=\"Navegação principal\">\n      <a href=\"/#sobre\">Quem somos</a>\n      <a href=\"/#ecossistema\">Ecossistema</a>\n      <a href=\"/#fluxo\">Como funciona</a>\n      <a href=\"/blog/\" aria-current=\"page\" style=\"position:relative;font-weight:800;background:linear-gradient(transparent 58%,rgba(247,200,66,.75) 58%);padding:1px 4px;border-radius:3px\">Blog</a><a href=\"/imprensa/\">Na imprensa</a>\n      <a href=\"/colabore.html\" rel=\"noopener\" class=\"navcta\">Quero colaborar com a ABREV</a>\n    </nav>\n  </div>\n</header>\n\n\n<div class=\"arthero\"><div class=\"wrap\"><nav class=\"crumbs\" aria-label=\"Caminho de navegação\"><a href=\"/\">Início</a> › <a href=\"/blog/\">Blog</a> › Newsletter</nav><span class=\"pill\">Reversa do Varejo — ABREV</span><h1>Black Friday e a onda de devoluções</h1><p class=\"lede\">Visibilidade, triagem e decisões de destino no pós-venda da Black Friday.</p><div class=\"artmeta\"><span>ABREV — Associação Brasileira de Reversa do Varejo</span><time datetime=\"2026-11-27\">27 de novembro de 2026</time></div></div></div>\n<main id=\"conteudo\" class=\"wrap\"><article class=\"article\"><!-- ABREV_NEWSLETTER:2026-11-27 -->\n<p>O fechamento de um pedido não encerra todas as relações entre o varejo, o produto e o cliente. Quando surge uma troca ou devolução, começa um novo percurso que precisa de informação, acompanhamento e decisão. No dia da Black Friday, vale revisar se esse caminho está claro para as equipes envolvidas.</p>\n<h2>Acompanhe o que chega, sem antecipar conclusões</h2>\n<p>Observe os registros da sua operação: solicitações abertas, produtos recebidos, itens aguardando avaliação e casos encerrados. Mantenha a definição de cada indicador explícita. Não apresente pedidos de devolução como produtos já devolvidos nem some ocorrências de períodos distintos sem explicar o recorte. Qualquer conclusão sobre o pico depende da medição real da empresa.</p>\n<h2>Preserve a visibilidade de cada etapa</h2>\n<p>Atendimento, recebimento e triagem precisam de uma referência comum para identificar os casos. Registre a passagem de etapa e os motivos de exceção. Essa informação pode apoiar a priorização operacional e a comunicação com o cliente. Se houver divergência entre o sistema e o item físico, trate a inconsistência antes de encerrar o caso.</p>\n<h2>Decida o destino a partir da condição</h2>\n<p>O retorno de um produto não define, por si só, seu destino. Avalie a condição, os critérios da categoria e as alternativas aplicáveis. Reparo, revenda e destinação adequada são caminhos a considerar conforme a avaliação. Mantenha registros que permitam entender por que uma decisão foi tomada e quem a executou.</p>\n<h2>Use as exceções para orientar a revisão</h2>\n<p>Uma solicitação parada pode revelar falta de informação, uma passagem de responsabilidade mal definida ou uma dependência de parceiro. Agrupe os motivos registrados e discuta onde intervir. A análise deve partir dos casos observados, sem transformar uma impressão isolada em diagnóstico de toda a operação.</p>\n<h2>Prepare o balanço e a ponte para dezembro</h2>\n<p>Defina quando o time vai comparar o que foi planejado com o que efetivamente ocorreu. Use o mesmo período e as mesmas definições ao comparar indicadores. Separe aprendizados confirmados, hipóteses que ainda precisam de dados e ações propostas para o próximo ciclo. No Cyber Monday, um balanço preliminar deve ser identificado como preliminar; os retornos podem continuar depois da data.</p>\n<p>O tema da ABREV neste mês é a reversa no pico do varejo. A proposta é tratar o retorno como um processo acompanhado e discutido entre as áreas, com decisões adequadas à realidade de cada operação.</p>\n<p>Leve essas perguntas à próxima reunião de pós-venda e registre os aprendizados do período.</p>\n<section class=\"cta\"><div><h3>Acompanhe a newsletter da ABREV</h3><p>Receba novas edições e compartilhe os aprendizados com sua equipe.</p></div><a class=\"btn\" href=\"https://www.linkedin.com/newsletters/reversa-do-varejo-%25E2%2580%2594-abrev-7527144656896434176/\">Assinar no LinkedIn</a></section></article></main>\n<footer class=\"footer\">\n  <div class=\"wrap\">\n    <div class=\"foot\">\n      <div>\n        <img src=\"/assets/images/abrev-logo-420.webp\" alt=\"ABREV\" width=\"1142\" height=\"240\" decoding=\"async\" srcset=\"/assets/images/abrev-logo-210.webp 210w, /assets/images/abrev-logo-420.webp 420w, /assets/images/abrev-logo-630.webp 630w\" sizes=\"210px\">\n        <p>Conhecimento · conexão · transformação</p>\n      </div>\n      <div>\n        <h4>Navegação</h4>\n        <p><a href=\"/#sobre\">Quem somos</a><br><a href=\"/#ecossistema\">Ecossistema</a><br><a href=\"/#fluxo\">Como funciona</a><br><a href=\"/blog/\">Blog</a><br><a href=\"/blog/logistica-reversa-no-varejo.html\">Guia de logística reversa</a><br><a href=\"/imprensa/\">Na imprensa</a></p>\n      </div>\n      <div>\n        <h4>Contato</h4>\n        <p><a href=\"mailto:adm@abrev.org\">adm@abrev.org</a></p>\n      </div>\n    </div>\n    <div class=\"fine\">© 2026 Associação Brasileira de Reversa do Varejo — ABREV.</div>\n  </div>\n</footer>\n\n<!-- POP-UP: FAÇA PARTE DA COMUNIDADE -->\n<script>\n// scroll reveal\nconst io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.15});\ndocument.querySelectorAll('.reveal').forEach(el=>io.observe(el));\n\n// Back-end ABREV (Apps Script)\nvar APPS_SCRIPT_URL='https://script.google.com/macros/s/AKfycbyJPKHIzLvghLIkJpORZd7vYTGiDzSY_ybiAdnub3CX4bLLzPx5O-eTDc0hxpRc9DjIDw/exec';\nfunction postAS(payload){ return fetch(APPS_SCRIPT_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain'},body:JSON.stringify(payload)}); }\nfunction canonUrl(){ var c=document.querySelector('link[rel=canonical]'); return (c&&c.href)||location.href; }\nfunction artigoTitulo(){ return (document.title.split('|')[0]||'').trim(); }\nfunction slugAtual(){ var p=canonUrl().split('?')[0].split('#')[0]; return p.substring(p.lastIndexOf('/')+1).replace(/\\.html?$/,''); }\n\n\n\n// Bloco \"Receber o estudo completo\" (Leads-Estudo → E2; opt-in entra na Comunidade)\n(function(){\n  var form=document.getElementById('estudoForm');\n  if(!form) return;\n  form.addEventListener('submit',async function(e){\n    e.preventDefault();\n    var btn=form.querySelector('button[type=\"submit\"]'), status=document.getElementById('eStatus'), label=btn.textContent;\n    var email=document.getElementById('eEmail').value.trim();\n    if(btn.disabled || !form.reportValidity()) return;\n    if(!email){ status.textContent='Informe um e-mail válido.'; return; }\n    btn.disabled=true; btn.textContent='Enviando…'; status.textContent='';\n    var payload={ action:'estudo', nome:document.getElementById('eName').value.trim(), email:email,\n      artigo:artigoTitulo(), artigo_url:canonUrl(), slug:slugAtual(),\n      opt_in:document.getElementById('eOptin').checked, origem:'blog' };\n    try{\n      await postAS(payload);\n      if(window.abrevAnalytics) window.abrevAnalytics.track('abrev_registration_request', {form_id:'study'});\n      form.innerHTML='<p style=\"color:var(--navy);font-weight:600;margin:0\">Solicitação enviada. Confira seu e-mail para receber o estudo completo. 📄</p>';\n    }catch(err){\n      if(window.abrevAnalytics) window.abrevAnalytics.track('abrev_registration_error', {form_id:'study'});\n      status.textContent='Não foi possível concluir agora. Tente novamente.';\n      btn.disabled=false; btn.textContent=label;\n    }\n  });\n})();\n</script>\n\n<script src=\"/assets/comunidade-popup.js?v=20261104-2\" defer></script>\n</body>\n</html>\n",
